# Invite codes that grant access to the builder.
# Format: CODE:DisplayName, comma-separated. DisplayName is used for tagging
# playtest sessions/logs, not for real identity verification.
ACCESS_CODES=TESTER-ALPHA:Alice,TESTER-BRAVO:Bob,TESTER-CHARLIE:Charlie

# Long random string used to sign session cookies (min 32 chars).
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
